<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: packaging/macos/package.sh substitutes @VERSION@ (full, e.g. 0.2.0-rc.1),
     @SHORT_VERSION@ (numeric X.Y.Z) and @BUILD_SHA@. -->
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key>
  <string>en</string>
  <key>CFBundleDisplayName</key>
  <string>transit</string>
  <key>CFBundleName</key>
  <string>transit</string>
  <key>CFBundleExecutable</key>
  <string>transit</string>
  <key>CFBundleIdentifier</key>
  <string>dev.derekmwright.transit</string>
  <key>CFBundleInfoDictionaryVersion</key>
  <string>6.0</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleSignature</key>
  <string>????</string>
  <key>CFBundleShortVersionString</key>
  <string>@SHORT_VERSION@</string>
  <key>CFBundleVersion</key>
  <string>@SHORT_VERSION@</string>
  <key>TransitVersion</key>
  <string>@VERSION@</string>
  <key>TransitBuildCommit</key>
  <string>@BUILD_SHA@</string>
  <key>CFBundleIconFile</key>
  <string>transit</string>
  <key>LSApplicationCategoryType</key>
  <string>public.app-category.music</string>
  <!-- Must match MACOSX_DEPLOYMENT_TARGET in package.sh. Big Sur is the first release on
       Apple silicon and has the Metal feature set wgpu targets. -->
  <key>LSMinimumSystemVersion</key>
  <string>11.0</string>
  <key>NSHighResolutionCapable</key>
  <true/>
  <key>NSSupportsAutomaticGraphicsSwitching</key>
  <true/>
  <key>NSRequiresAquaSystemAppearance</key>
  <false/>
  <!-- Shown by macOS the first time transit opens an input device (recording). -->
  <key>NSMicrophoneUsageDescription</key>
  <string>transit records audio from the input you choose.</string>
  <key>NSHumanReadableCopyright</key>
  <string>Copyright © the transit authors. MIT OR Apache-2.0.</string>

  <!-- transit's own session format (extension and MIME type unchanged): a JSON session file next to an "Audio Files" folder. -->
  <key>UTExportedTypeDeclarations</key>
  <array>
    <dict>
      <key>UTTypeIdentifier</key>
      <string>dev.derekmwright.transit.session</string>
      <key>UTTypeDescription</key>
      <string>transit Session</string>
      <key>UTTypeConformsTo</key>
      <array>
        <string>public.data</string>
        <string>public.content</string>
      </array>
      <key>UTTypeIconFile</key>
      <string>transit</string>
      <key>UTTypeTagSpecification</key>
      <dict>
        <key>public.filename-extension</key>
        <array><string>transit</string><string>scraft</string></array>
        <key>public.mime-type</key>
        <array><string>application/x-soundcraft-session</string></array>
      </dict>
    </dict>
  </array>

  <key>CFBundleDocumentTypes</key>
  <array>
    <dict>
      <key>CFBundleTypeName</key>
      <string>transit Session</string>
      <key>CFBundleTypeRole</key>
      <string>Editor</string>
      <key>LSHandlerRank</key>
      <string>Owner</string>
      <key>CFBundleTypeIconFile</key>
      <string>transit</string>
      <key>LSItemContentTypes</key>
      <array><string>dev.derekmwright.transit.session</string></array>
    </dict>
    <!-- Audio and MIDI: offered under "Open With" (imported into a session), never taking over
         the user's default player. -->
    <dict>
      <key>CFBundleTypeName</key>
      <string>Audio File</string>
      <key>CFBundleTypeRole</key>
      <string>Viewer</string>
      <key>LSHandlerRank</key>
      <string>Alternate</string>
      <key>LSItemContentTypes</key>
      <array>
        <string>com.microsoft.waveform-audio</string>
        <string>public.aiff-audio</string>
        <string>public.aifc-audio</string>
        <string>org.xiph.flac</string>
        <string>public.mp3</string>
      </array>
    </dict>
    <dict>
      <key>CFBundleTypeName</key>
      <string>MIDI File</string>
      <key>CFBundleTypeRole</key>
      <string>Viewer</string>
      <key>LSHandlerRank</key>
      <string>Alternate</string>
      <key>LSItemContentTypes</key>
      <array><string>public.midi-audio</string></array>
    </dict>
  </array>
</dict>
</plist>
